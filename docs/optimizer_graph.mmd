---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	propose(propose)
	run(run<hr/><small><em>__interrupt = before</em></small>)
	decide(decide)
	__end__([<p>__end__</p>]):::last
	__start__ --> propose;
	decide --> propose;
	propose -.-> run;
	propose -. &nbsp;end&nbsp; .-> __end__;
	run -.-> decide;
	run -. &nbsp;end&nbsp; .-> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc

